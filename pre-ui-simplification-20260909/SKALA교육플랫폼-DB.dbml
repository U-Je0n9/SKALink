// SKALog 학습 지식 공유 플랫폼 데이터 모델
// API v1.1.0 기준. floor는 1~5반=4층, 6~10반=5층 규칙을 적용한다.

Enum user_role {
  STUDENT
  PROFESSOR
  ADMIN
}

Enum user_status {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
}

Enum instructor_kind {
  LEAD
  PRACTICE
}

Enum question_status {
  OPEN
  RESOLVED
}

Enum post_type {
  EXPLANATION
  MATERIAL
}

Enum visibility_scope {
  ALL
  FLOOR
  CLASS
}

Table users {
  id bigint [pk, increment]
  email varchar(254) [not null, unique, note: '로그인 ID. 비교 시 소문자 정규화']
  password_hash varchar(255) [not null, note: '원문 비밀번호 저장 금지']
  name varchar(100) [not null]
  role user_role [not null]
  status user_status [not null, default: 'PENDING']
  p_code varchar(4) [unique, note: '교육생만 사용, P+숫자 3자리']
  employee_no varchar(5) [unique, note: '교수님만 사용, T+숫자 4자리']
  class_number int [note: '교육생만 1~10. floor 응답은 이 값으로 계산']
  email_verified_at timestamp
  approved_by bigint
  approved_at timestamp
  rejected_reason varchar(500)
  deactivated_at timestamp
  last_login_at timestamp
  revision int [not null, default: 1, note: '관리자 수정 낙관적 잠금']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: '역할별 CHECK: STUDENT는 p_code/class_number 필수, PROFESSOR는 employee_no 필수, ADMIN은 둘 다 null. ACTIVE 전환 시 email_verified_at 필수.'
}

Table registration_directory {
  identity_no varchar(5) [pk, note: '교육생 P코드 또는 교수님 사번']
  role user_role [not null, note: 'STUDENT 또는 PROFESSOR만 허용']
  name varchar(100) [not null]
  email varchar(254) [not null, unique]
  class_number int [note: '교육생만 1~10']
  is_current boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: '회원가입 자동 승인을 위한 내부 기준 명단. 관리자 화면의 학생 목록과는 별개이며 직접 노출하지 않는다.'
}

Table email_verifications {
  id bigint [pk, increment]
  email varchar(254) [not null]
  code_hash varchar(255) [not null]
  attempt_count int [not null, default: 0]
  sent_at timestamp [not null, default: `now()`]
  expires_at timestamp [not null]
  verified_at timestamp
  verification_token_hash varchar(255) [unique]
  token_expires_at timestamp
  consumed_at timestamp
  created_at timestamp [not null, default: `now()`]

  indexes {
    (email, created_at) [name: 'idx_email_verifications_email_created']
  }
}

Table auth_sessions {
  id uuid [pk]
  user_id bigint [not null]
  token_hash varchar(255) [not null, unique, note: 'HttpOnly 세션 쿠키의 해시']
  expires_at timestamp [not null]
  revoked_at timestamp
  last_seen_at timestamp [not null, default: `now()`]
  ip_hash varchar(255)
  user_agent varchar(500)
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, revoked_at, expires_at) [name: 'idx_auth_sessions_user_active']
  }
}

Table courses {
  id bigint [pk, increment]
  internal_code varchar(50) [not null, unique, note: '서버 자동 생성']
  title varchar(150) [not null]
  description text
  color_key varchar(20) [not null, default: 'green', note: 'green/orange/blue/violet']
  is_archived boolean [not null, default: false]
  revision int [not null, default: 1]
  created_by bigint [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: 'API의 phase/displayPeriod는 로그인 사용자의 층에 맞는 course_sessions와 현재 날짜로 계산한다. leadProfessors/isMine/권한은 배정 테이블로 계산한다.'
}

Table course_sessions {
  id bigint [pk, increment]
  course_id bigint [not null]
  floor_number int [not null, note: '4 또는 5']
  start_date date [not null]
  end_date date [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (course_id, floor_number) [unique]
  }

  Note: 'CHECK: floor_number IN (4,5), start_date <= end_date. 과목별 두 층 일정은 관리자 저장 트랜잭션에서 검증.'
}

Table course_instructor_assignments {
  id bigint [pk, increment]
  course_id bigint [not null]
  professor_id bigint [not null]
  class_number int [not null, note: '1~10']
  floor_number int [not null, note: 'class_number에 따라 4 또는 5']
  instructor_kind instructor_kind [not null]
  assigned_at timestamp [not null, default: `now()`]

  indexes {
    (course_id, class_number) [unique, note: '한 반에 교수님 한 분']
    (course_id, professor_id) [unique, note: '한 과목에서 교수님은 한 반만 담당']
    (course_id, floor_number, instructor_kind) [name: 'idx_course_assignment_floor_kind']
  }

  Note: '저장 시 10개 반/서로 다른 교수님 10명, 4층 LEAD 1+PRACTICE 4, 5층 LEAD 1+PRACTICE 4를 검증. 교수님 역할·활성 상태도 검증.'
}

Table questions {
  id bigint [pk, increment]
  course_id bigint [not null]
  author_id bigint [not null]
  related_post_id bigint
  title varchar(150) [not null]
  body text [not null]
  status question_status [not null, default: 'OPEN']
  resolved_at timestamp
  revision int [not null, default: 1]
  is_hidden boolean [not null, default: false]
  hidden_reason varchar(1000)
  hidden_by bigint
  hidden_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (course_id, status, created_at) [name: 'idx_questions_course_status_created']
    (author_id, created_at) [name: 'idx_questions_author_created']
  }
}

Table question_tags {
  question_id bigint [not null]
  tag varchar(50) [not null]
  display_order int [not null]

  indexes {
    (question_id, display_order) [pk]
    (question_id, tag) [unique]
    (tag) [name: 'idx_question_tags_tag']
  }
}

Table answers {
  id bigint [pk, increment]
  question_id bigint [not null]
  author_id bigint [not null]
  author_role_at_creation user_role [not null, note: 'STUDENT 또는 PROFESSOR']
  body text [not null]
  revision int [not null, default: 1]
  is_hidden boolean [not null, default: false]
  hidden_reason varchar(1000)
  hidden_by bigint
  hidden_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (question_id, author_role_at_creation, created_at) [name: 'idx_answers_question_role_created']
  }
}

Table posts {
  id bigint [pk, increment]
  course_id bigint [not null]
  author_id bigint [not null]
  author_instructor_kind instructor_kind [not null, note: '작성 당시 전임/실습 구분 보존']
  type post_type [not null]
  visibility_scope visibility_scope [not null]
  visibility_floor int
  visibility_class_number int
  title varchar(150) [not null]
  body text
  revision int [not null, default: 1]
  is_hidden boolean [not null, default: false]
  hidden_reason varchar(1000)
  hidden_by bigint
  hidden_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (course_id, type, author_instructor_kind, updated_at) [name: 'idx_posts_course_type_priority']
    (visibility_scope, visibility_floor, visibility_class_number) [name: 'idx_posts_visibility']
  }

  Note: '공개 범위 CHECK: ALL은 대상 둘 다 null, FLOOR는 visibility_floor만 4/5, CLASS는 visibility_class_number만 1~10. MATERIAL은 material_versions 1개 이상, EXPLANATION은 버전 없음.'
}

Table material_versions {
  id bigint [pk, increment]
  post_id bigint [not null]
  version_number int [not null]
  change_note text [not null]
  created_by bigint [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (post_id, version_number) [unique]
    (post_id, created_at) [name: 'idx_material_versions_post_created']
  }
}

Table material_version_files {
  id bigint [pk, increment]
  material_version_id bigint [not null]
  original_file_name varchar(255) [not null]
  storage_key varchar(500) [not null, unique, note: '외부 스토리지 내부 키, 공개 응답 제외']
  file_size_bytes bigint [not null]
  mime_type varchar(150) [not null]
  checksum_sha256 char(64)
  display_order int [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (material_version_id, display_order) [unique]
  }
}

Table material_reads {
  user_id bigint [not null]
  post_id bigint [not null]
  last_seen_version_id bigint [not null]
  seen_at timestamp [not null]

  indexes {
    (user_id, post_id) [pk]
  }

  Note: '버전 확인 상태. last_seen_version_id는 반드시 같은 post_id의 버전이어야 하며 더 낮은 버전으로 역행시키지 않는다.'
}

Table post_user_states {
  user_id bigint [not null]
  post_id bigint [not null]
  read_at timestamp
  dismissed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, post_id) [pk]
    (user_id, dismissed_at, updated_at) [name: 'idx_post_user_states_notice']
  }

  Note: '학생 메인의 새 자료 블록에만 사용하는 개인 읽음/숨김 상태. material_reads의 버전 확인과 의미가 다르다.'
}

Ref: users.approved_by > users.id
Ref: auth_sessions.user_id > users.id
Ref: courses.created_by > users.id
Ref: course_sessions.course_id > courses.id
Ref: course_instructor_assignments.course_id > courses.id
Ref: course_instructor_assignments.professor_id > users.id
Ref: questions.course_id > courses.id
Ref: questions.author_id > users.id
Ref: questions.related_post_id > posts.id
Ref: questions.hidden_by > users.id
Ref: question_tags.question_id > questions.id
Ref: answers.question_id > questions.id
Ref: answers.author_id > users.id
Ref: answers.hidden_by > users.id
Ref: posts.course_id > courses.id
Ref: posts.author_id > users.id
Ref: posts.hidden_by > users.id
Ref: material_versions.post_id > posts.id
Ref: material_versions.created_by > users.id
Ref: material_version_files.material_version_id > material_versions.id
Ref: material_reads.user_id > users.id
Ref: material_reads.post_id > posts.id
Ref: material_reads.last_seen_version_id > material_versions.id
Ref: post_user_states.user_id > users.id
Ref: post_user_states.post_id > posts.id
